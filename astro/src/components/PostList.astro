---
import { formatPostDate, getPostUrl, getTagUrl, type ReadingPost } from '../lib/reading-posts'

interface Props {
  posts: ReadingPost[]
}

const { posts } = Astro.props
---

<div class="post-list">
  {posts.map((post) => (
    <div class="post-row">
      <div class="post-title-column">
        <div class="post-title">
          <a href={getPostUrl(post)}>{post.data.title}</a>
        </div>
        <div class="post-tags">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="post-tags-icon"
          >
            <path d="M3 8v4.172a2 2 0 0 0 .586 1.414l5.71 5.71a2.41 2.41 0 0 0 3.408 0l3.592 -3.592a2.41 2.41 0 0 0 0 -3.408l-5.71 -5.71a2 2 0 0 0 -1.414 -.586h-4.172a2 2 0 0 0 -2 2"
            ></path>
            <path d="M18 19l1.592 -1.592a4.82 4.82 0 0 0 0 -6.816l-4.592 -4.592"></path>
            <path d="M7 10h-.01"></path>
          </svg>
          {post.data.tags.map((tag, index) => (
            <a href={getTagUrl(tag)}>{tag}{index < post.data.tags.length - 1 ? ', ' : ''}</a>
          ))}
        </div>
      </div>
      <div class="post-date-column">
        <time datetime={post.data.date}>{formatPostDate(post.data.date)}</time>
      </div>
    </div>
  ))}
</div>
