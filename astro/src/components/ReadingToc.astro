---
interface Heading {
  depth: number
  slug: string
  text: string
}

interface TocNode extends Heading {
  children: TocNode[]
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props

const buildHeadingTree = (items: Heading[]): TocNode[] => {
  const roots: TocNode[] = []
  const stack: TocNode[] = []

  for (const heading of items) {
    const node: TocNode = { ...heading, children: [] }
    while (stack.length && stack[stack.length - 1].depth >= node.depth) stack.pop()

    if (stack.length) stack[stack.length - 1].children.push(node)
    else roots.push(node)

    stack.push(node)
  }

  return roots
}

const escapeHtml = (value: string): string =>
  value.replace(/[&<>"']/g, (character) => {
    switch (character) {
      case '&':
        return '&amp;'
      case '<':
        return '&lt;'
      case '>':
        return '&gt;'
      case '"':
        return '&quot;'
      case "'":
        return '&#39;'
      default:
        return character
    }
  })

function renderTocNodes(nodes: TocNode[], isRoot = false): string {
  const listClass = ' class="toc-list"'
  const listItems = nodes
    .map((node) => {
      const slug = escapeHtml(node.slug)
      const label = escapeHtml((node.text || node.slug).replace(/\s+/g, ' ').trim())
      const children = node.children.length ? renderTocNodes(node.children) : ''
      return `<li><a href="#${slug}">${label}</a>${children}</li>`
    })
    .join('')

  const list = `<ul${listClass}>${listItems}</ul>`
  return isRoot ? list : `<div class="toc-nested">${list}</div>`
}

const nodes = buildHeadingTree(headings)
const listHtml = nodes.length ? renderTocNodes(nodes, true) : ''
---

{listHtml && (
  <nav class="toc" aria-label="Table of contents">
    <details data-toc open>
      <summary><span>목차</span><svg class="toc-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6.5L8 11L12.5 6.5" /></svg></summary>
      <div class="toc-content" set:html={listHtml}></div>
    </details>
  </nav>
)}
